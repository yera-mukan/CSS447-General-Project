{
  "uid": "ocr-autoscaling-lab",
  "title": "OCR autoscaling lab (k3s, single node)",
  "tags": [
    "ocr",
    "autoscaling",
    "hpa",
    "vpa"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "scenario",
        "label": "Scenario",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(k6_vus, scenario)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Load: k6 VUs",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Virtual users. k6_vus has no scenario tag, so this is the shared load profile (identical for all runs).",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(k6_vus)",
          "legendFormat": "VUs"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Load: RPS",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Requests per second, computed from the k6 counter.",
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(k6_http_reqs_total{scenario=~\"$scenario\"}[1m])) by (scenario)",
          "legendFormat": "{{scenario}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Latency p95 (k6)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Client-side p95. Includes k6/CPU contention on this single-node lab.",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(k6_http_req_duration_p95{scenario=~\"$scenario\"}) by (scenario)",
          "legendFormat": "{{scenario}} p95"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Error rate",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Non-2xx share of requests.",
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(k6_http_reqs_total{scenario=~\"$scenario\",status!~\"2..\"}[1m])) by (scenario) / sum(rate(k6_http_reqs_total{scenario=~\"$scenario\"}[1m])) by (scenario)",
          "legendFormat": "{{scenario}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Replicas",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "How many pods the Deployment/HPA want vs how many are available.",
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "kube_deployment_status_replicas{namespace=\"ocr-lab\",deployment=\"ocr\"}",
          "legendFormat": "deployment desired"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "kube_deployment_status_replicas_available{namespace=\"ocr-lab\",deployment=\"ocr\"}",
          "legendFormat": "deployment available"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "kube_horizontalpodautoscaler_status_current_replicas{namespace=\"ocr-lab\",horizontalpodautoscaler=\"ocr\"}",
          "legendFormat": "HPA current"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "kube_horizontalpodautoscaler_status_desired_replicas{namespace=\"ocr-lab\",horizontalpodautoscaler=\"ocr\"}",
          "legendFormat": "HPA desired"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Pending pods",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Pods that could not be scheduled. On one node this happens when maxReplicas exceeds capacity.",
      "gridPos": {
        "x": 12,
        "y": 17,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(kube_pod_status_phase{namespace=\"ocr-lab\",phase=\"Pending\"})",
          "legendFormat": "pending"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "CPU usage vs requests",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "usage = sum(rate(container_cpu_usage_seconds_total[1m])); requests = sum(kube_pod_container_resource_requests).",
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "ocr:cpu_usage_cores",
          "legendFormat": "usage (cores)"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "ocr:cpu_requests_cores",
          "legendFormat": "requests (cores)"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "ocr:node_vcpu",
          "legendFormat": "node vCPU"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "CPU utilization (usage / requests)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Exactly what the CPU-based HPA looks at.",
      "gridPos": {
        "x": 12,
        "y": 25,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "ocr:cpu_usage_cores / ocr:cpu_requests_cores",
          "legendFormat": "utilization"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "RAM usage vs requests/limits",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Working set vs memory requests/limits.",
      "gridPos": {
        "x": 0,
        "y": 33,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8
          },
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "ocr:mem_usage_bytes",
          "legendFormat": "usage"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "ocr:mem_requests_bytes",
          "legendFormat": "requests"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(kube_pod_container_resource_limits{namespace=\"ocr-lab\",container=\"ocr\",resource=\"memory\"})",
          "legendFormat": "limits"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "CPU throttling",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Share of CFS periods throttled. We do not set a CPU limit, so this should stay near zero unless the node is saturated.",
      "gridPos": {
        "x": 12,
        "y": 33,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(container_cpu_cfs_throttled_periods_total{namespace=\"ocr-lab\",container=\"ocr\"}[1m])) / sum(rate(container_cpu_cfs_periods_total{namespace=\"ocr-lab\",container=\"ocr\"}[1m]))",
          "legendFormat": "throttled"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Restarts (5m increase)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Includes restarts caused by VPA evictions and by OOM/probe failures.",
      "gridPos": {
        "x": 0,
        "y": 41,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(kube_pod_container_status_restarts_total{namespace=\"ocr-lab\",container=\"ocr\"}[5m]))",
          "legendFormat": "restarts"
        }
      ]
    },
    {
      "type": "table",
      "title": "Last termination reasons",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Reason of the last termination: OOMKilled, Error, Completed, ...",
      "gridPos": {
        "x": 12,
        "y": 41,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "kube_pod_container_status_last_terminated_reason{namespace=\"ocr-lab\",container=\"ocr\"}",
          "legendFormat": "{{reason}} {{pod}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "VPA CPU: recommendations vs request",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "VPA recommendations exposed by kube-state-metrics customResourceState.",
      "gridPos": {
        "x": 0,
        "y": 49,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "kube_verticalpodautoscaler_status_recommendation_containerrecommendations_target_cpu{namespace=\"ocr-lab\"}",
          "legendFormat": "target"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "kube_verticalpodautoscaler_status_recommendation_containerrecommendations_lowerbound_cpu{namespace=\"ocr-lab\"}",
          "legendFormat": "lowerBound"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "kube_verticalpodautoscaler_status_recommendation_containerrecommendations_upperbound_cpu{namespace=\"ocr-lab\"}",
          "legendFormat": "upperBound"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "ocr:cpu_requests_cores",
          "legendFormat": "current requests"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "VPA RAM: recommendations vs request",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 49,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8
          },
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "kube_verticalpodautoscaler_status_recommendation_containerrecommendations_target_memory{namespace=\"ocr-lab\"}",
          "legendFormat": "target"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "kube_verticalpodautoscaler_status_recommendation_containerrecommendations_lowerbound_memory{namespace=\"ocr-lab\"}",
          "legendFormat": "lowerBound"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "kube_verticalpodautoscaler_status_recommendation_containerrecommendations_upperbound_memory{namespace=\"ocr-lab\"}",
          "legendFormat": "upperBound"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "ocr:mem_requests_bytes",
          "legendFormat": "current requests"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Cost per hour (model)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "allocated_cost_per_hour models reserved CPU/RAM at the node price. The real EC2 bill is constant.",
      "gridPos": {
        "x": 0,
        "y": 57,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8
          },
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "ocr:allocated_cost_per_hour",
          "legendFormat": "allocated resources"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "ocr:node_price_per_hour",
          "legendFormat": "node price"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Cumulative cost over selected range",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Integral approximation over the dashboard time range.",
      "gridPos": {
        "x": 12,
        "y": 57,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8
          },
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "avg_over_time(ocr:allocated_cost_per_hour[$__range]) * ($__range_s / 3600)",
          "legendFormat": "allocated (range)"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "ocr:node_price_per_hour * ($__range_s / 3600)",
          "legendFormat": "node (range)"
        }
      ]
    }
  ],
  "annotations": {
    "list": [
      {
        "name": "Lab runs",
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": false,
        "iconColor": "red",
        "target": {
          "limit": 100,
          "matchAny": true,
          "tags": [
            "ocr-run"
          ],
          "type": "tags"
        }
      }
    ]
  }
}