{
  "info": {
    "_postman_id": "a1373529-6ea4-4686-abe8-35c647fac4c7",
    "name": "OCR App API (CSS447)",
    "description": "OCR service (tesseract-server). Endpoints: health, status, POST /tesseract (multipart). Base URL is configurable via the baseUrl variable. Before sending OCR requests, select load/sample.png in the file field.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://16.192.176.90:8884",
      "type": "string"
    },
    {
      "key": "imagePath",
      "value": "load/sample.png",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Readiness",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/.well-known/health/ready",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                ".well-known",
                "health",
                "ready"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('status is UP', () => pm.expect(j.status).to.eql('UP'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Liveness",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/.well-known/health/live",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                ".well-known",
                "health",
                "live"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Metadata",
      "item": [
        {
          "name": "Status / build info",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "status"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('has version', () => pm.expect(j.data.version).to.be.a('string'));",
                  "console.log('version:', j.data.version, 'commit:', j.data.commit);"
                ]
              }
            }
          ]
        },
        {
          "name": "Web UI (HTML)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                ""
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('returns HTML', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('text/html'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "OCR",
      "item": [
        {
          "name": "Recognize image (default, PSM 3)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "load/sample.png",
                  "description": "Select load/sample.png (or any PNG/JPG) before sending."
                },
                {
                  "key": "options",
                  "type": "text",
                  "value": "{\"languages\":[\"eng\"],\"pageSegmentationMethod\":3}",
                  "description": "JSON string. PSM 3 = auto page segmentation without OSD."
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/tesseract",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tesseract"
              ]
            },
            "description": "Multipart POST: file=<image>, options=<JSON string>. Returns data.stdout with recognized text."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('has data.exit', () => pm.expect(j.data.exit.code).to.eql(0));",
                  "pm.test('has OCR output', () => pm.expect(j.data.stdout).to.be.a('string'));",
                  "pm.test('recognized some text', () => pm.expect(j.data.stdout.trim().length).to.be.above(0));",
                  "console.log(j.data.stdout.substring(0, 400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Recognize image (single line, PSM 7)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "load/sample.png"
                },
                {
                  "key": "options",
                  "type": "text",
                  "value": "{\"languages\":[\"eng\"],\"pageSegmentationMethod\":7}"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/tesseract",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tesseract"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('has text', () => pm.expect(pm.response.json().data.stdout.length).to.be.above(0));"
                ]
              }
            }
          ]
        },
        {
          "name": "Recognize image (custom config / whitelist)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "load/sample.png"
                },
                {
                  "key": "options",
                  "type": "text",
                  "value": "{\"languages\":[\"eng\"],\"pageSegmentationMethod\":3,\"configParams\":{\"tessedit_char_whitelist\":\"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789 \"}}"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/tesseract",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tesseract"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Negative",
      "item": [
        {
          "name": "No file -> 400",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "options",
                  "type": "text",
                  "value": "{\"languages\":[\"eng\"]}"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/tesseract",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tesseract"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 400 or 500', () => pm.expect([400,500]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}